VITE_API_URL=http://127.0.0.1:8000/api/v1
TOKENSCOPE_DATABASE_URL=sqlite:///database/sqlite/tokenscope.db
TOKENSCOPE_API_KEY=
TOKENSCOPE_INGEST_RATE_LIMIT=600
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
# Local is the active runtime default. Enterprise requires a real identity adapter.
AIOPT_OPERATING_MODE=local
# DATABASE_URL takes precedence over TOKENSCOPE_DATABASE_URL when supplied.
# Inject credential-bearing database URLs from a protected environment/vault.
# AIOPT_REQUIRE_SIGNING=1 makes absent production signing inputs a build failure.
