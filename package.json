{
  "name": "ai-optimization-tool",
  "version": "0.12.0",
  "private": true,
  "description": "Open-source AI capacity intelligence and FinOps dashboard",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "backend:package": "powershell -ExecutionPolicy Bypass -File scripts/package-backend.ps1",
    "test:ui": "playwright test",
    "test:ui:update": "playwright test --update-snapshots",
    "release:verify-version": "powershell -ExecutionPolicy Bypass -File scripts/verify-version.ps1",
    "release:checksum": "powershell -ExecutionPolicy Bypass -File scripts/checksum-installer.ps1",
    "release:sbom": "powershell -ExecutionPolicy Bypass -File scripts/generate-sbom.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.8.4",
    "vite": "^7.1.3"
  }
}
